{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(tests/run.sh)",
      "Bash(sh tests/run.sh)",
      "Bash(php tests/smoke_*)",
      "Bash(node tests/smoke_*)",
      "Bash(php -l *)",
      "Bash(bin/build_spec.sh)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Bash(bin/deploy.sh*)",
      "Bash(bin/deploy_curriculum.sh*)",
      "Bash(php bin/reset_db.php*)",
      "Bash(php bin/delete_session.php*)",
      "Bash(php bin/prune_orphaned_sessions.php*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
