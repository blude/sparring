# example .env file -- make a copy named .env and edit the value below
# used by config.php when running under a web SAPI (Valet, prod php-fpm, ...)
# that doesn't inherit a shell's `export` — see .envrc.example for CLI/php -S
ANTHROPIC_API_KEY=---

# Uncomment to switch provider — 'openai' covers OpenAI itself and any
# OpenAI-Chat-Completions-compatible local server (e.g. LM Studio).
# LLM_PROVIDER=openai
# OPENAI_API_KEY=---              # can stay unset for LM Studio
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_GENERATION_MODEL=---     # the model ID loaded in LM Studio, or an OpenAI model
# OPENAI_CLASSIFICATION_MODEL=---

# Or, offline with no key at all (UI work, demos): canned "(fake)" replies.
# Never for the exhibition. See README "Switch LLM provider".
# LLM_PROVIDER=fake
# FAKE_LLM_DELAY_MS=1500          # optional, to see the waiting states
