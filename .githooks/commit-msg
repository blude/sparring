#!/bin/sh
# Rejects commit messages that don't follow Conventional Commits
# (https://www.conventionalcommits.org/). No deps — plain POSIX sh so it
# works without npm/commitlint, matching this project's no-build-step rule.
# `composer install` wires this up automatically (core.hooksPath). Manual:
# git config core.hooksPath .githooks

msg_file="$1"
first_line=$(head -n1 "$msg_file")

# type(scope)!: subject — scope optional, "!" marks a breaking change
pattern='^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)(\([a-zA-Z0-9./_-]+\))?!?: .+'

if ! printf '%s' "$first_line" | grep -qE "$pattern"; then
  echo "commit-msg: not a Conventional Commit: \"$first_line\"" >&2
  echo "  expected: type(scope)?: subject   e.g. fix(dojo): correct timeout race" >&2
  echo "  types: feat fix docs style refactor perf test chore build ci revert" >&2
  exit 1
fi
