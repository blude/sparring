#!/bin/sh
# Rejects a commit that changes prompts/sparring.md without also touching
# prompts/CHANGELOG.md (see CLAUDE.md "prompts/sparring.md"). Same shape as
# commit-msg: plain POSIX sh, no deps, wired by `composer install`.
# Bypass for a genuine no-op (whitespace-only fix): git commit --no-verify.

staged=$(git diff --cached --name-only)

printf '%s\n' "$staged" | grep -qx 'prompts/sparring.md' || exit 0

# Needs an added, non-blank line, not just any touch of the file. Doesn't
# insist on "## Unreleased": the entry may already sit under its dated
# heading when committed (see CLAUDE.md).
if ! git diff --cached -- prompts/CHANGELOG.md | grep '^+' | grep -v '^+++ ' \
     | sed 's/^+//' | grep -q '[^[:space:]]'; then
  echo "pre-commit: prompts/sparring.md changed without a prompts/CHANGELOG.md entry" >&2
  echo "  log it under '## Unreleased' in prompts/CHANGELOG.md and stage that too" >&2
  exit 1
fi
